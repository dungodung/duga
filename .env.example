# Copy to .env for local development. Never commit the real .env file.

FLASK_ENV=development
SECRET_KEY=change-me-dev-only

# --- Database (local docker-compose mariadb; ToolsDB in production, via
#     Toolforge's auto-provisioned TOOL_TOOLSDB_USER/PASSWORD -- see
#     app/config.py) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=duga
DB_USER=duga
DB_PASSWORD=duga

# Mandatory descriptive User-Agent for outbound Wikimedia API/WDQS calls
# (scope_fetch/topic_refresh jobs).
DUGA_USER_AGENT="Duga/0.1 (https://duga.toolforge.org; maintainer contact via meta.wikimedia.org) requests"

# The on-wiki scope definition page scope_fetch reads. See docs/scope-definition.md.
# DUGA_SCOPE_PAGE=Wikidata:WikiProject LGBT/Duga scope
